# =====================================================================
# CashBack — example environment variables
#
#   make env    creates `.env` from this file and fills every empty secret
#               below with a random value (never overwrites an existing .env)
#   make up     starts the stack with it
#
# Without `.env` docker compose refuses to start ("run make env"): the
# services have no built-in secrets (stage B, docs/adr/0013-auth-hardening.md).
# =====================================================================

# ---------- General ----------
COMPOSE_PROJECT_NAME=cashback
ENVIRONMENT=local
LOG_LEVEL=INFO
TZ=UTC

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cashback
POSTGRES_USER=cashback
POSTGRES_PASSWORD=cashback
POSTGRES_DSN=postgresql://cashback:cashback@postgres:5432/cashback

# Airflow metastore (separate DB on the same Postgres instance)
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow

# MLflow backend store DB (separate DB on the same Postgres instance)
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=cashback
CLICKHOUSE_USER=cashback
CLICKHOUSE_PASSWORD=cashback

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=localhost:9094
KAFKA_CLIENT_ID=cashback
KAFKA_CONSUMER_GROUP=cashback-consumers
KAFKA_TOPIC_TRANSACTIONS=transactions.raw
KAFKA_TOPIC_RECOMMENDATIONS=recommendations.events
KAFKA_TOPIC_CAMPAIGN_EVENTS=campaigns.events

# ---------- Schema Registry ----------
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts
MLFLOW_S3_ENDPOINT_URL=

# ---------- Airflow ----------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Public placeholders of the Airflow UI (like its admin/admin login and
# Grafana's): not application secrets, outside stage B — tracked in
# docs/AUDIT.md §6. Change them for anything but a local demo.
AIRFLOW__WEBSERVER__SECRET_KEY=please-change-me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@cashback.local
AIRFLOW_UID=50000

# ---------- Service ports (host) ----------
RECOMMENDATION_API_PORT=8001
CAMPAIGN_MANAGER_PORT=8002
MOBILE_API_PORT=8003
TRANSACTION_LISTENER_METRICS_PORT=9101

# ---------- Application secrets (B19, B20, B12 — ADR-0013) ----------
# Leave the values empty here: `make env` writes random ones into .env
# (keys: `openssl rand -hex 32`, passwords: `openssl rand -base64 18`).
# Services refuse to start with an empty value, one shorter than 32 bytes
# or a public default (`please-change-me`, `dev-secret-change-me`, …).
# Three keys with three purposes — a leak of one must not forge the others:
#
# JWT_SECRET          campaign_manager only: admin access / refresh / SSE tokens.
JWT_SECRET=
# SERVICE_JWT_SECRET  service tokens into recommendation_api: signed by
#                     mobile_api and campaign_manager, verified by rec_api.
#                     Must differ from JWT_SECRET and MOBILE_JWT_SECRET.
SERVICE_JWT_SECRET=
# MOBILE_JWT_SECRET   customer tokens for mobile_api (/v1/mobile/*). In
#                     production the bank IdP signs them; in the demo
#                     `python3 scripts/mint_customer_token.py --user-id <uuid>`.
#                     Must differ from JWT_SECRET: whoever holds it could
#                     otherwise sign admin tokens. No service sees both keys,
#                     so only `make env` (on an existing .env) warns.
MOBILE_JWT_SECRET=
MOBILE_JWT_ISSUER=cashback-demo-idp

# Password of the bootstrap admin admin@bank.ru. Applied by the migration
# that creates the account (`make migrate` on a fresh database; on a database
# that still has the legacy admin/admin it replaces that password and the
# admin must change it at first login). Empty → the migration generates a
# random password and prints "bootstrap admin password: …" ONCE — change
# it at first login. Changing this value later does not change an existing
# account. Min 12 characters.
ADMIN_BOOTSTRAP_PASSWORD=
# Password of the seeder's demo logins (m.sokolova@bank.ru — MARKETER,
# d.ivanov@bank.ru — ANALYST; `make seed-demo`). Empty → random, printed in
# the seeder summary. On a database where the old seeder left them with the
# public passwords marketer / analyst, `make migrate` (008) replaces those
# with this value — or with a random one printed once as "demo users
# password: …" — and they must change it at first login. Min 12 characters.
DEMO_USERS_PASSWORD=

# Browser origins allowed to call the APIs cross-origin (comma-separated or
# a JSON list). The UI itself is same-origin through nginx (:3000) and the
# Vite dev proxy (:5173); "*" is rejected (credentials are allowed).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Feature flags ----------
ENABLE_RECOMMENDATIONS=true
ENABLE_CAMPAIGNS=true
