  freq_5541 = 12   amt_5541 = 36 000 ₽   ← + АЗС с большим чеком
  freq_5812 = 18   amt_5812 = 22 400 ₽   ← + рестораны
  freq_4121 =  9   amt_4121 =  5 400 ₽
  freq_5912 =  4   amt_5912 =  3 100 ₽
  freq_5732 =  1   amt_5732 = 24 999 ₽   ← одна крупная покупка электроники
  ... остальные 44 MCC = 0  (пользователь не тратит) ...
  ────────────────────────────────────────────────
  tenure_months = 18 (в банке 1.5 года — лоялен)
end note

@enduml
