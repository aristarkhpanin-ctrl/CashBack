{
  "components": {
    "schemas": {
      "CashbackBalance": {
        "properties": {
          "available_amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Available Amount",
            "type": "string"
          },
          "currency": {
            "default": "RUB",
            "title": "Currency",
            "type": "string"
          },
          "paid_amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Paid Amount",
            "type": "string"
          },
          "pending_amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Pending Amount",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "pending_amount",
          "available_amount",
          "paid_amount"
        ],
        "title": "CashbackBalance",
        "type": "object"
      },
      "CashbackHistoryItem": {
        "properties": {
          "accrual_id": {
            "format": "uuid",
            "title": "Accrual Id",
            "type": "string"
          },
          "accrued_at": {
            "format": "date-time",
            "title": "Accrued At",
            "type": "string"
          },
          "cashback_amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cashback Amount",
            "type": "string"
          },
          "category_name": {
            "title": "Category Name",
            "type": "string"
          },
          "mcc_code": {
            "title": "Mcc Code",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Transaction Amount",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "accrual_id",
          "transaction_id",
          "mcc_code",
          "category_name",
          "transaction_amount",
          "cashback_amount",
          "status",
          "accrued_at"
        ],
        "title": "CashbackHistoryItem",
        "type": "object"
      },
      "CashbackHistoryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CashbackHistoryItem"
            },
            "title": "Items",
            "type": "array"
          },
          "period_from": {
            "format": "date-time",
            "title": "Period From",
            "type": "string"
          },
          "period_to": {
            "format": "date-time",
            "title": "Period To",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "period_from",
          "period_to",
          "items"
        ],
        "title": "CashbackHistoryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MobileRecommendation": {
        "description": "Mobile-friendly recommendation payload — no model internals.",
        "properties": {
          "campaign_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Campaign Id"
          },
          "campaign_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Campaign Name"
          },
          "cashback_rate": {
            "examples": [
              "5%"
            ],
            "title": "Cashback Rate",
            "type": "string"
          },
          "category_icon_url": {
            "title": "Category Icon Url",
            "type": "string"
          },
          "category_name": {
            "title": "Category Name",
            "type": "string"
          },
          "deeplink": {
            "title": "Deeplink",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "mcc_code": {
            "title": "Mcc Code",
            "type": "string"
          },
          "recommendation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Id"
          },
          "terms_summary": {
            "maxLength": 140,
            "title": "Terms Summary",
            "type": "string"
          }
        },
        "required": [
          "mcc_code",
          "category_name",
          "category_icon_url",
          "cashback_rate",
          "terms_summary",
          "deeplink"
        ],
        "title": "MobileRecommendation",
        "type": "object"
      },
      "MobileRecommendationsResponse": {
        "properties": {
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/MobileRecommendation"
            },
            "title": "Recommendations",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "recommendations"
        ],
        "title": "MobileRecommendationsResponse",
        "type": "object"
      },
      "RespondAction": {
        "enum": [
          "ACCEPTED",
          "DECLINED",
          "SNOOZE"
        ],
        "title": "RespondAction",
        "type": "string"
      },
      "RespondRequest": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/RespondAction"
          },
          "channel": {
            "default": "IN_APP",
            "enum": [
              "PUSH",
              "SMS",
              "EMAIL",
              "IN_APP"
            ],
            "title": "Channel",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "RespondRequest",
        "type": "object"
      },
      "RespondResponse": {
        "properties": {
          "accepted_offer_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted Offer Key"
          },
          "action": {
            "$ref": "#/components/schemas/RespondAction"
          },
          "recommendation_id": {
            "format": "uuid",
            "title": "Recommendation Id",
            "type": "string"
          },
          "snooze_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snooze Until"
          }
        },
        "required": [
          "recommendation_id",
          "action"
        ],
        "title": "RespondResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Backend-for-Frontend for the mobile client. Wraps Recommendation API + Postgres + Redis.",
    "title": "Cashback Mobile BFF",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "meta"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Endpoint that serves Prometheus metrics.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/v1/mobile/cashback/balance/{user_id}": {
      "get": {
        "operationId": "cashback_balance_v1_mobile_cashback_balance__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashbackBalance"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cashback Balance",
        "tags": [
          "mobile"
        ]
      }
    },
    "/v1/mobile/cashback/history/{user_id}": {
      "get": {
        "operationId": "cashback_history_v1_mobile_cashback_history__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "period_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Period From"
            }
          },
          {
            "in": "query",
            "name": "period_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Period To"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashbackHistoryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cashback History",
        "tags": [
          "mobile"
        ]
      }
    },
    "/v1/mobile/recommendations/{recommendation_id}/respond": {
      "post": {
        "operationId": "respond_to_recommendation_v1_mobile_recommendations__recommendation_id__respond_post",
        "parameters": [
          {
            "in": "path",
            "name": "recommendation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recommendation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespondResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Respond To Recommendation",
        "tags": [
          "mobile"
        ]
      }
    },
    "/v1/mobile/recommendations/{user_id}": {
      "get": {
        "operationId": "get_mobile_recommendations_v1_mobile_recommendations__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "top_k",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Top K"
            }
          },
          {
            "in": "query",
            "name": "transaction_amount",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Transaction Amount"
            }
          },
          {
            "in": "query",
            "name": "channel",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(ONLINE|POS|ATM|MOBILE)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Channel"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileRecommendationsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Mobile Recommendations",
        "tags": [
          "mobile"
        ]
      }
    }
  }
}
